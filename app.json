{
  "expo": {
    "name": "VietCarbon",
    "slug": "viet-carbon",
    "version": "1.0.0",
    "description": "Ứng dụng đo lường và giảm thiểu CO₂ cá nhân",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "vietcarbon",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tienkhoa.vietcarbon",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "VietCarbon cần truy cập camera để chụp ảnh hoạt động",
        "NSPhotoLibraryUsageDescription": "VietCarbon cần truy cập thư viện ảnh để chọn ảnh"
      }
    },
    "android": {    
      "package": "com.tienkhoa.vietcarbon",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "vietcarbon"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "34.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font"

    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "googleClientId": "1068759411281-tq08k6gjrfipi4pjfbv0k01iqpojl49r.apps.googleusercontent.com",
      "eas": {
        "projectId": "0d6cf527-b195-4162-9567-8d875bb6a18a"
      }
    },
    "owner": "tienkhoa",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "githubUrl": "https://github.com/LuuTienKhoa/FE_VietCarbon"
  }
}
